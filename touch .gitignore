# --- Базовые исключения для всех проектов ---

# Временные файлы ОС
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Бэкапы и автосохранения редакторов
*~
*.bak
*.backup
*.swp
*.swo
*.tmp
*.temp

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-z][a-z]

# VS Code
.vscode/
*.code-workspace

# JetBrains (IntelliJ IDEA, PyCharm, WebStorm и др.)
.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Atom
.atom/

# Emacs
*#
.\#*

# --- Специфика для тренировки Git-конфликтов ---

# Файлы-бэкапы, которые создаёт sed (если будешь запускать скрипт на macOS/Linux)
*.bak

# Любые автогенерируемые файлы, которые могут появиться в процессе тренировки
/generated/
/tmp/

# --- Прочее (опционально, можно убрать, если не нужно) ---

# Логи и кэш
/logs/
/log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Артефакты сборки (если позже добавишь компилируемые языки)
/build/
/dist/
/node_modules/
/vendor/

git add .gitignore
git commit -m "chore: added .gitignore to exclude temp files and editor backups"
